    <PackageVersion Include="NOrganizze" Version="0.1.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.12.47" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <!-- Tests -->
